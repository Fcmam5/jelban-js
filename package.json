{
  "name": "jelban.js",
  "version": "1.1.0",
  "description": "Another email addresses filter; filters out disposable and addresses' alias",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./domains": {
      "import": {
        "types": "./dist/domains.d.mts",
        "default": "./dist/domains.mjs"
      },
      "require": {
        "types": "./dist/domains.d.cts",
        "default": "./dist/domains.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest --testMatch **/test/integration/**/*.integration.spec.ts ----coverageDirectory coverage/integration",
    "test:watch": "npm run test -- --watch",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check src/**/*.ts",
    "mutate": "stryker run",
    "doc-gen": "typedoc src/index.ts"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fcmam5/jelban-js.git"
  },
  "keywords": [
    "email",
    "spam",
    "privacy"
  ],
  "author": "Fortas Abdeldjalil (Fcmam5)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Fcmam5/jelban-js/issues"
  },
  "homepage": "https://github.com/Fcmam5/jelban-js#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsdown": "^0.23.4",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
